# ── Runtime artifacts (DB, token, logs, QA scratch) ─────────────────────
# Ignore everything under the runtime dir, then whitelist the skeleton and
# the canonical fixture — nothing QA-generated can ever be committed.
artifacts/**
!artifacts/.gitkeep
!artifacts/spike/.gitkeep
!artifacts/spike/resources/
!artifacts/spike/resources/sample-tracking-file/
!artifacts/spike/resources/sample-tracking-file/clients.csv


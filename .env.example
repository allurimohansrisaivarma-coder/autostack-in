# ─────────────────────────────────────────────────────────────────────────────
# AutoStack IN — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Service bearer token for the worker API.
# Auto-generated on first run and persisted to artifacts/spike/token.
# Set this only if you want to override the auto-generated token.
AUTOSTACK_TOKEN=

# AI provider: "mock" (default, deterministic, offline — CI-safe) or
# "gemini" (Google Gemini REST generateContent).
# Gemini is used only when the provider is "gemini" AND a non-empty API key is
# present; every other configuration runs the offline mock. If Gemini errors
# (bad key, rate limit, network, timeout, malformed output), generation falls
# back to the offline generator automatically — automation creation never
# hard-errors because of the AI vendor.
AUTOSTACK_AI_PROVIDER=mock

# Required only when AUTOSTACK_AI_PROVIDER=gemini.
# Get your key from: https://aistudio.google.com/app/apikey
# Keys live ONLY in the environment — never in git, the DB, or the UI.
# The legacy alias AUTOSTACK_GEMINI_API_KEY is also accepted.
AUTOSTACK_GEMINI_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DATA DIRECTORY / RAILWAY PERSISTENCE (launch-critical)
# Users, workflows, the registry, and the audit chain all live in SQLite at
# <data dir>/spike.db. Without a persistent directory, EVERY REDEPLOY WIPES
# ALL DATA (accounts included).
#
# Railway operators — Git cannot attach the volume for you; do this once in
# the Railway UI:
#   1. Service → Volumes → attach a Volume mounted at /data
#   2. Set AUTOSTACK_DATA_DIR=/data on the service (the worker Dockerfile
#      already defaults to it)
#   3. Redeploy — boot logs print `[autostack:persistence]` with the resolved
#      data dir and whether the DB already existed
#   4. Register the owner account once; from then on data survives rebuilds
#
# AUTOSTACK_REQUIRE_PERSISTENT_DATA=1 fail-fasts at boot when persistence
# cannot be trusted (also auto-enabled on Railway); useful for any managed
# host. AUTOSTACK_ALLOW_EMPTY_DATA_DIR=1 allows exactly the first boot on a
# genuinely new, empty volume. Local development needs none of these.
#
# AUTOSTACK_DATA_DIR=/data
# AUTOSTACK_REQUIRE_PERSISTENT_DATA=1
# AUTOSTACK_ALLOW_EMPTY_DATA_DIR=1
# ─────────────────────────────────────────────────────────────────────────────

# Optional: comma-separated extra CORS origins for the worker API (Railway
# deployments set this to the Vercel frontend URL, e.g.
# https://autostack-in.vercel.app; https://*.vercel.app is always accepted).
# ALLOWED_ORIGINS=

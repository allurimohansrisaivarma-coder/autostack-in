# ─────────────────────────────────────────────────────────────────────────────
# AutoStack IN — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Service bearer token for the worker API.
# Auto-generated on first run and persisted to artifacts/spike/token.
# Set this only if you want to override the auto-generated token.
AUTOSTACK_TOKEN=

# AI provider: "mock" (default, deterministic, offline — CI-safe) or
# "gemini" (Google Gemini REST generateContent).
# Gemini is used only when the provider is "gemini" AND a non-empty API key is
# present; every other configuration runs the offline mock. If Gemini errors
# (bad key, rate limit, network, timeout, malformed output), generation falls
# back to the offline generator automatically — automation creation never
# hard-errors because of the AI vendor.
AUTOSTACK_AI_PROVIDER=mock

# Required only when AUTOSTACK_AI_PROVIDER=gemini.
# Get your key from: https://aistudio.google.com/app/apikey
# Keys live ONLY in the environment — never in git, the DB, or the UI.
# The legacy alias AUTOSTACK_GEMINI_API_KEY is also accepted.
AUTOSTACK_GEMINI_KEY=

# Optional: custom data directory (default: artifacts/spike)
# AUTOSTACK_DATA_DIR=artifacts/spike

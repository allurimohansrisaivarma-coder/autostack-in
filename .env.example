# ─────────────────────────────────────────────────────────────────────────────
# AutoStack IN — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Service bearer token for the worker API.
# Auto-generated on first run and persisted to artifacts/spike/token.
# Set this only if you want to override the auto-generated token.
AUTOSTACK_TOKEN=

# AI provider: "mock" (default, deterministic, offline — CI-safe) or
# "gemini" (Google Gemini REST generateContent).
# Gemini is used only when the provider is "gemini" AND a non-empty API key is
# present; every other configuration runs the offline mock. If Gemini errors
# (bad key, rate limit, network, timeout, malformed output), generation falls
# back to the offline generator automatically — automation creation never
# hard-errors because of the AI vendor.
AUTOSTACK_AI_PROVIDER=mock

# Required only when AUTOSTACK_AI_PROVIDER=gemini.
# Get your key from: https://aistudio.google.com/app/apikey
# Keys live ONLY in the environment — never in git, the DB, or the UI.
# The legacy alias AUTOSTACK_GEMINI_API_KEY is also accepted.
AUTOSTACK_GEMINI_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Production (Vercel + Railway) Setup
# ─────────────────────────────────────────────────────────────────────────────
# All state (users, workflows, registry, audit chain) lives in SQLite at
# <AUTOSTACK_DATA_DIR>/spike.db. Container filesystems are ephemeral: without a
# persistent volume, every redeploy wipes all data. Git cannot attach the volume.
#
# Exact Railway Configuration Steps:
#   1. Volume on worker service: In Railway UI, worker service -> Volumes -> Add
#      Volume mounted at /data
#   2. AUTOSTACK_DATA_DIR=/data: Set in worker service Variables
#   3. Optional: ALLOWED_ORIGINS=https://autostack-in.vercel.app (all *.vercel.app
#      domains are allowed by default in code)
#   4. Redeploy worker: Confirm GET /api/health returns 200 {"status":"ok"}
#   5. First empty DB: Register owner account once in the UI (survives future deploys)
#   6. If persistence guard blocks first boot on an empty volume: Set temporary
#      AUTOSTACK_ALLOW_EMPTY_DATA_DIR=1 in Variables, redeploy to create spike.db,
#      then remove the hatch variable once DB exists
#
# Example Railway service variables:
# AUTOSTACK_DATA_DIR=/data
# ALLOWED_ORIGINS=https://autostack-in.vercel.app
# AUTOSTACK_ALLOW_EMPTY_DATA_DIR=1
# AUTOSTACK_TOKEN=


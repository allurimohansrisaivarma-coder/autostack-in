# Spike S6 artifact: worker container image (FastAPI worker; Node-RED stays embedded in the
# desktop shell — NOT containerized, it must reach local files/devices).
FROM python:3.13-slim

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend/ backend/

# Non-root, unprivileged runtime.
RUN useradd --create-home appuser
USER appuser

ENV AUTOSTACK_DATA_DIR=/data
EXPOSE 8747

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8747/api/health', timeout=2)"

CMD ["python", "-m", "uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8747"]
